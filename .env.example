# 服务端口
PORT=8787

# 决策模型端点。trial 域名无需 WorkspaceId，适合演示。
DASHSCOPE_ENDPOINT=https://trial.cn-beijing.maas.aliyuncs.com/compatible-mode/v1/systemone
DASHSCOPE_MODEL=decision-model-preview

# 如果使用业务空间专属域名，换成：
# DASHSCOPE_ENDPOINT=https://<你的WorkspaceId>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1/systemone

# 密钥保险箱主密码。用 `npm run vault` 生成，不要提交到任何地方。
ORACLE_MASTER_KEY=

# 可选：不加密时直接把密钥放环境变量（不推荐）
# DASHSCOPE_API_KEY=

# 限流与保护
RATE_LIMIT_MAX=40
RATE_LIMIT_WINDOW_MS=600000
GLOBAL_MODEL_LIMIT_PER_HOUR=300
TRUST_PROXY=0

# 可选：部署后限制来源站点，多个用英文逗号分隔
# ALLOWED_ORIGINS=https://your-domain.com
